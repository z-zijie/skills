// m2_model -- calibrate the AIC (Cube) pipes with hardware counters.
//
// The Cube engine (AIC) has its own pipe set: MTE1 (L1->L0A/L0B), M (MAC),
// FIXPIPE (L0C->UB/GM), plus MTE2 (GM->L1) and MTE3. msprof's PipeUtilization
// group reports each separately (aic_mac_time, aic_fixpipe_time, aic_mte1_time,
// aic_mte2_time, aic_mte3_time) alongside aic_total_cycles, so the same
// counter-based method used for the AIV pipes applies.
//
// This kernel does a plain M x K * K x N matmul on each Cube core with a
// caller-chosen repetition count, so the MAC/Fixpipe cost per FLOP and per
// output element can be separated by differencing.
//
// Reported per launch: aiv/aic cycle totals + per-pipe times (via msprof).
#include <cstdio>
#include <cstdlib>
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"

using namespace AscendC;
using namespace AscendC::Te;

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __cube__ void mm_kernel(__gm__ half* a, __gm__ half* b, __gm__ float* c, int32_t reps)
{
    InitSocState();
    constexpr uint32_t baseM = M;
    constexpr uint32_t baseK = K;
    constexpr uint32_t baseN = N;

    uint32_t blk = GetBlockIdx();

    auto gmA = MakeTensor(MakeMemPtr(a), MakeFrameLayout<NDExtLayoutPtn>(M * 64, K));
    auto gmB = MakeTensor(MakeMemPtr(b), MakeFrameLayout<NDExtLayoutPtn>(K, N));
    auto gmC = MakeTensor(MakeMemPtr(c), MakeFrameLayout<NDExtLayoutPtn>(M * 64, N));

    auto globalA = gmA.Slice(MakeCoord(blk * M, 0), MakeShape(baseM, K));
    auto globalB = gmB.Slice(MakeCoord(0, 0), MakeShape(K, baseN));
    auto globalC = gmC.Slice(MakeCoord(blk * M, 0), MakeShape(baseM, baseN));

    auto l1ALayout = MakeFrameLayout<NZLayoutPtn>(baseM, K);
    auto l1BLayout = MakeFrameLayout<NZLayoutPtn>(K, baseN);
    auto l0ALayout = MakeFrameLayout<NZLayoutPtn>(baseM, baseK);
    auto l0BLayout = MakeFrameLayout<ZNLayoutPtn>(baseK, baseN);
    auto l0CLayout = MakeFrameLayout<NZLayoutPtn>(baseM, baseN);

    __cbuf__ half l1ABuf[baseM * K];
    __cbuf__ half l1BBuf[K * baseN];
    __ca__ half l0ABuf[baseM * baseK];
    __cb__ half l0BBuf[baseK * baseN];
    __cc__ float l0CBuf[baseM * baseN];

    auto l1ATensor = MakeTensor(MakeMemPtr(l1ABuf), l1ALayout);
    auto l1BTensor = MakeTensor(MakeMemPtr(l1BBuf), l1BLayout);
    auto l0ATensor = MakeTensor(MakeMemPtr(l0ABuf), l0ALayout);
    auto l0BTensor = MakeTensor(MakeMemPtr(l0BBuf), l0BLayout);
    auto l0CTensor = MakeTensor(MakeMemPtr(l0CBuf), l0CLayout);

    auto copyGM2L1 = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto copyL12L0A = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto copyL12L0B = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto copyL0C2GM = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmadAtom = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    Mutex::Lock<PIPE_MTE2>(0);
    Copy(copyGM2L1, l1ATensor, globalA);
    Copy(copyGM2L1, l1BTensor, globalB);
    Mutex::Unlock<PIPE_MTE2>(0);

    for (int32_t r = 0; r < reps; ++r) {
        Mutex::Lock<PIPE_MTE1>(0);
        Copy(copyL12L0A, l0ATensor, l1ATensor);
        Copy(copyL12L0B, l0BTensor, l1BTensor);
        Mutex::Unlock<PIPE_MTE1>(0);

        Mutex::Lock<PIPE_M>(0);
        AscendC::Te::MmadParams para{baseM, baseN, baseK, 0, r == 0};
        Mmad(mmadAtom.with(para), l0CTensor, l0ATensor, l0BTensor);
        Mutex::Unlock<PIPE_M>(0);
    }

    Mutex::Lock<PIPE_FIX>(0);
    Copy(copyL0C2GM, globalC, l0CTensor);
    Mutex::Unlock<PIPE_FIX>(0);
}

static void Check(aclError e, const char* w)
{
    if (e != ACL_SUCCESS) { fprintf(stderr, "ACL %d at %s\n", (int)e, w); exit(1); }
}

int main(int argc, char** argv)
{
    if (argc < 4) {
        fprintf(stderr, "usage: %s <out.csv> <reps> <blocks>\n", argv[0]);
        return 2;
    }
    const char* out = argv[1];
    int32_t reps = atoi(argv[2]);
    int32_t blocks = atoi(argv[3]);

    Check(aclInit(nullptr), "aclInit");
    Check(aclrtSetDevice(0), "setDevice");
    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "createStream");

    constexpr uint32_t M = 128, K = 256, N = 128;
    constexpr int64_t aBytes = int64_t(M) * 64 * K * 2;
    constexpr int64_t bBytes = int64_t(K) * N * 2;
    constexpr int64_t cBytes = int64_t(M) * 64 * N * 4;
    void *a = nullptr, *b = nullptr, *c = nullptr;
    Check(aclrtMalloc(&a, aBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc a");
    Check(aclrtMalloc(&b, bBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc b");
    Check(aclrtMalloc(&c, cBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc c");
    Check(aclrtMemset(a, aBytes, 0, aBytes), "memset a");
    Check(aclrtMemset(b, bBytes, 0, bBytes), "memset b");
    Check(aclrtMemset(c, cBytes, 0, cBytes), "memset c");

    // warmup
    for (int32_t i = 0; i < 5; ++i) {
        mm_kernel<M, K, N><<<blocks, 0, stream>>>((__gm__ half*)a, (__gm__ half*)b,
                                                  (__gm__ float*)c, reps);
        Check(aclrtSynchronizeStream(stream), "sync");
    }
    FILE* f = fopen(out, "w");
    fprintf(f, "reps,blocks\n");
    for (int32_t i = 0; i < 5; ++i) {
        mm_kernel<M, K, N><<<blocks, 0, stream>>>((__gm__ half*)a, (__gm__ half*)b,
                                                  (__gm__ float*)c, reps);
        Check(aclrtSynchronizeStream(stream), "sync");
        fprintf(f, "%d,%d\n", reps, blocks);
    }
    fclose(f);
    fprintf(stderr, "[host] M=%u K=%u N=%u reps=%d blocks=%d\n", M, K, N, reps, blocks);

    aclrtFree(a); aclrtFree(b); aclrtFree(c);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
