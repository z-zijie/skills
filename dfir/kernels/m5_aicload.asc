// m5_aicload -- calibrate the AIC-side GM->L1 load rate.
//
// This is the piece M4 exposed as missing: in matmul_leakyrelu the AIC-side
// GM->L1 load is 33% of the operator's time, yet the model had folded it into a
// constant t_setup. The load clearly scales with matrix size, so measure the
// rate directly.
//
// AIC only; no Mmad at all, so aic_mte2_time is the pure load cost. Sweep
// `chunks` (each 32KB) to get bytes vs time.
#include <cstdio>
#include <cstdlib>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"

using namespace AscendC;

constexpr int64_t kChunkBytes = 32 * 1024;
constexpr int32_t kMaxChunks = 64;
constexpr int64_t kSlotBytes = 2 * 1024 * 1024;

struct Params {
    int64_t srcOffset;
    int32_t chunks;
};

__global__ __cube__ void aicload_kernel(GM_ADDR src, Params p)
{
    // L1 is 512KB; 8 x 32KB staging buffers, cycled so a big sweep still fits.
    LocalMemAllocator<Hardware::L1> l1;
    for (int32_t i = 0; i < p.chunks; ++i) {
        LocalTensor<half> buf = l1.Alloc<half>(kChunkBytes / sizeof(half));
        GlobalTensor<half> g;
        g.SetGlobalBuffer((__gm__ half*)src + p.srcOffset / sizeof(half)
                          + int64_t(i % 8) * (kChunkBytes / sizeof(half)),
                          kChunkBytes / sizeof(half));
        DataCopyExtParams cp{1, static_cast<uint32_t>(kChunkBytes), 0, 0, 0};
        DataCopyPadExtParams<half> pad{false, 0, 0, 0};
        DataCopyPad(buf, g, cp, pad);
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    }
}

static void Check(aclError e, const char* w)
{
    if (e != ACL_SUCCESS) { fprintf(stderr, "ACL %d at %s\n", (int)e, w); exit(1); }
}

int main(int argc, char** argv)
{
    if (argc < 5) { fprintf(stderr, "usage: %s <out.csv> <chunks> <blocks> <reps>\n", argv[0]); return 2; }
    const char* out = argv[1];
    Params p{};
    p.chunks = atoi(argv[2]);
    if (p.chunks < 1) p.chunks = 1;
    if (p.chunks > kMaxChunks) p.chunks = kMaxChunks;
    int32_t blocks = atoi(argv[3]);
    int32_t reps = atoi(argv[4]);

    Check(aclInit(nullptr), "aclInit");
    Check(aclrtSetDevice(0), "setDevice");
    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "createStream");

    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    int32_t aicNum = plat->GetCoreNumAic();
    if (blocks <= 0 || blocks > aicNum) blocks = aicNum;

    int64_t perLaunch = int64_t(aicNum) * kSlotBytes;
    int64_t srcBytes = perLaunch * 20;
    void* src = nullptr;
    Check(aclrtMalloc(&src, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST), "src");
    Check(aclrtMemset(src, srcBytes, 0, srcBytes), "ms");

    FILE* f = fopen(out, "w");
    fprintf(f, "chunks,blocks,launch\n");
    for (int32_t i = 0; i < 5; ++i) {
        aicload_kernel<<<blocks, 0, stream>>>((__gm__ uint8_t*)src, p);
        Check(aclrtSynchronizeStream(stream), "sync");
    }
    for (int32_t r = 0; r < reps; ++r) {
        p.srcOffset = (r % 16) * perLaunch;
        aicload_kernel<<<blocks, 0, stream>>>((__gm__ uint8_t*)src, p);
        Check(aclrtSynchronizeStream(stream), "sync");
        fprintf(f, "%d,%d,%d\n", p.chunks, blocks, r);
    }
    fclose(f);
    fprintf(stderr, "[host] chunks=%d blocks=%d reps=%d\n", p.chunks, blocks, reps);
    aclrtFree(src);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
