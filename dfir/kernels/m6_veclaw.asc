// m6_veclaw -- calibrate VEC cost versus CoreNum.
//
// M4 exposed that the VEC coefficient measured on 56 saturated cores
// (0.033 cyc/elem/core) is 6.3x too high for a 4-core launch (0.00524). So VEC
// needs its own CoreNum law, the same way MTE2 got one in M1.
//
// AIV only. Loads a tile once with MTE2, then does K vector passes over N
// elements so the per-pass marginal cost is pure VEC.
#include <cstdio>
#include <cstdlib>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"

using namespace AscendC;

constexpr int32_t kTileElems = 25600;
constexpr int64_t kSlotBytes = 1024 * 1024;

struct Params { int64_t srcOffset; int32_t passes; };

__global__ __vector__ void veclaw_kernel(GM_ADDR src, GM_ADDR dst, Params p)
{
    int64_t blk = GetBlockIdx();
    TPipe pipe;
    TBuf<TPosition::VECIN> ubx, uby;
    pipe.InitBuffer(ubx, kTileElems * sizeof(float));
    pipe.InitBuffer(uby, kTileElems * sizeof(float));
    LocalTensor<float> x = ubx.Get<float>();
    LocalTensor<float> y = uby.Get<float>();

    GlobalTensor<float> g;
    g.SetGlobalBuffer((__gm__ float*)src + blk * kTileElems, kTileElems);
    DataCopyPadExtParams<float> pad{false, 0, 0, 0};
    DataCopyExtParams cp{1, static_cast<uint32_t>(kTileElems * sizeof(float)), 0, 0, 0};
    DataCopyPad(x, g, cp, pad);
    DataCopyPad(y, g, cp, pad);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);

    for (int32_t i = 0; i < p.passes; ++i) {
        Add(x, x, y, kTileElems);
        PipeBarrier<PIPE_V>();
    }
    SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
    WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
    GlobalTensor<float> o;
    o.SetGlobalBuffer((__gm__ float*)dst + blk * kTileElems, kTileElems);
    DataCopyPad(o, x, cp);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
}

static void Check(aclError e, const char* w)
{
    if (e != ACL_SUCCESS) { fprintf(stderr, "ACL %d at %s\n", (int)e, w); exit(1); }
}

int main(int argc, char** argv)
{
    if (argc < 5) { fprintf(stderr, "usage: %s <out.csv> <passes> <blocks> <reps>\n", argv[0]); return 2; }
    const char* out = argv[1];
    Params p{};
    p.passes = atoi(argv[2]);
    int32_t blocks = atoi(argv[3]);
    int32_t reps = atoi(argv[4]);

    Check(aclInit(nullptr), "aclInit");
    Check(aclrtSetDevice(0), "setDevice");
    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "createStream");

    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    int32_t aivNum = plat->GetCoreNumAiv();
    if (blocks <= 0 || blocks > aivNum) blocks = aivNum;

    int64_t perLaunch = int64_t(aivNum) * kSlotBytes;
    int64_t nbytes = perLaunch * 20;
    void *src = nullptr, *dst = nullptr;
    Check(aclrtMalloc(&src, nbytes, ACL_MEM_MALLOC_HUGE_FIRST), "src");
    Check(aclrtMalloc(&dst, nbytes, ACL_MEM_MALLOC_HUGE_FIRST), "dst");
    Check(aclrtMemset(src, nbytes, 0, nbytes), "ms");
    Check(aclrtMemset(dst, nbytes, 0, nbytes), "md");

    FILE* f = fopen(out, "w");
    fprintf(f, "passes,blocks,launch\n");
    for (int32_t i = 0; i < 5; ++i) {
        veclaw_kernel<<<blocks, 0, stream>>>((__gm__ uint8_t*)src, (__gm__ uint8_t*)dst, p);
        Check(aclrtSynchronizeStream(stream), "sync");
    }
    for (int32_t r = 0; r < reps; ++r) {
        p.srcOffset = (r % 16) * perLaunch;
        veclaw_kernel<<<blocks, 0, stream>>>((__gm__ uint8_t*)src, (__gm__ uint8_t*)dst, p);
        Check(aclrtSynchronizeStream(stream), "sync");
        fprintf(f, "%d,%d,%d\n", p.passes, blocks, r);
    }
    fclose(f);
    fprintf(stderr, "[host] passes=%d blocks=%d reps=%d\n", p.passes, blocks, reps);
    aclrtFree(src); aclrtFree(dst);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
