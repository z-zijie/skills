// m3_model -- measure the cost of AIC<->AIV cooperation in a MIX kernel (M3).
//
// A MIX kernel runs Cube and Vector code from ONE launch: each physical core
// carries both an AIC and an AIV part, and they rendezvous through
// CrossCoreSetFlag / CrossCoreWaitFlag. That handshake is pure overhead which no
// single-engine model can predict, so it has to be measured on its own.
//
// Structure (mirrors samples/.../cv_datapath 1_mix_scenario1):
//   AIC: one Mmad, then CrossCoreSetFlag<PIPE_FIX> to tell AIV the tile is ready
//   AIV: CrossCoreWaitFlag, one ReLU pass, then set the flag back
//   loop `iters` times
//
// By also running the same loop with iters=1 vs iters=N and with/without the
// handshake, the per-handshake cost separates out.
#include <cstdio>
#include <cstdlib>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"

using namespace AscendC;

constexpr int32_t kFlagId = 1;
constexpr uint32_t FElems = 128 * 128;          // ReLU tile
constexpr int64_t kSlotBytes = 1024 * 1024;

struct Params {
    int64_t srcOffset;
    int32_t iters;
    int32_t sync;      // 1 = do the cross-core handshake, 0 = skip it
    int32_t work;      // AIC-side busy iterations, so AIV actually has to wait
};

__global__ __mix__(1, 2) void mix_kernel(GM_ADDR src, GM_ADDR dst, GM_ADDR stamps, Params p)
{
    int64_t blk = GetBlockIdx();

    if ASCEND_IS_AIC {
        // Cube side: a small matmul-ish busy loop, then signal the AIV partner.
        for (int32_t i = 0; i < p.iters; ++i) {
            // Real Cube-side work: a chain of scalar ops the optimiser cannot
            // fold, standing in for an Mmad whose latency AIV must wait on.
            int64_t acc = GetSystemCycle();
            for (int32_t w = 0; w < p.work; ++w) {
                acc = acc * 6364136223846793005LL + 1442695040888963407LL;
                acc ^= (acc >> 17);
            }
            if (p.sync) {
                CrossCoreSetFlag<0x2, PIPE_FIX>(kFlagId);
            }
            // keep acc live
            if (acc == 0x1234567890LL) {
                CrossCoreSetFlag<0x2, PIPE_FIX>(kFlagId);
            }
        }
        return;
    }

    if ASCEND_IS_AIV {
        TPipe pipe;
        TBuf<TPosition::VECIN> ub;
        TBuf<TPosition::VECIN> ubx;
        pipe.InitBuffer(ub, 8 * sizeof(int64_t));
        pipe.InitBuffer(ubx, FElems * sizeof(float));
        LocalTensor<float> x = ubx.Get<float>();
        LocalTensor<int64_t> ls = ub.Get<int64_t>();

        GlobalTensor<float> gsrc;
        gsrc.SetGlobalBuffer((__gm__ float*)src + blk * FElems, FElems);
        DataCopyPadExtParams<float> pad{false, 0, 0, 0};
        DataCopyExtParams cpv{1, static_cast<uint32_t>(FElems * sizeof(float)), 0, 0, 0};
        DataCopyPad(x, gsrc, cpv, pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);

        int64_t t0 = GetSystemCycle();
        for (int32_t i = 0; i < p.iters; ++i) {
            if (p.sync) {
                CrossCoreWaitFlag(kFlagId);
            }
            Abs(x, x, FElems);
            PipeBarrier<PIPE_V>();
        }
        SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
        WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
        // store the result so the vector work cannot be eliminated
        GlobalTensor<float> gdst;
        gdst.SetGlobalBuffer((__gm__ float*)dst + blk * FElems, FElems);
        DataCopyPad(gdst, x, cpv);
        SetFlag<HardEvent::MTE3_S>(EVENT_ID3);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID3);
        int64_t t1 = GetSystemCycle();

        ls.SetValue(0, t0);
        ls.SetValue(1, t1);
        PipeBarrier<PIPE_ALL>();
        GlobalTensor<int64_t> gs;
        gs.SetGlobalBuffer((__gm__ int64_t*)stamps + blk * 8, 8);
        DataCopyExtParams cp{1, 16, 0, 0, 0};
        DataCopyPad(gs, ls, cp);
        SetFlag<HardEvent::MTE3_S>(EVENT_ID7);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID7);
    }
}

static void Check(aclError e, const char* w)
{
    if (e != ACL_SUCCESS) { fprintf(stderr, "ACL %d at %s\n", (int)e, w); exit(1); }
}

int main(int argc, char** argv)
{
    if (argc < 6) { fprintf(stderr, "usage: %s <out.csv> <iters> <sync> <blocks> <reps> [work]\n", argv[0]); return 2; }
    const char* out = argv[1];
    Params p{};
    p.iters = atoi(argv[2]);
    p.sync = atoi(argv[3]);
    p.work = argc > 6 ? atoi(argv[6]) : 0;
    int32_t blocks = atoi(argv[4]);
    int32_t reps = atoi(argv[5]);

    Check(aclInit(nullptr), "aclInit");
    Check(aclrtSetDevice(0), "setDevice");
    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "createStream");

    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    int32_t aivNum = plat->GetCoreNumAiv();
    if (blocks <= 0 || blocks > aivNum) blocks = aivNum;

    int64_t perLaunch = int64_t(aivNum) * kSlotBytes;
    int64_t srcBytes = perLaunch * 20;
    void *src = nullptr, *dst = nullptr, *st = nullptr;
    Check(aclrtMalloc(&src, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST), "src");
    Check(aclrtMalloc(&dst, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST), "dst");
    Check(aclrtMalloc(&st, int64_t(aivNum) * 8 * sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST), "st");
    Check(aclrtMemset(src, srcBytes, 0, srcBytes), "ms");
    Check(aclrtMemset(dst, srcBytes, 0, srcBytes), "md");

    FILE* f = fopen(out, "w");
    fprintf(f, "iters,sync,blocks,launch,core,t0,t1\n");
    for (int32_t i = 0; i < 5; ++i) {
        mix_kernel<<<blocks, 0, stream>>>((__gm__ uint8_t*)src, (__gm__ uint8_t*)dst,
                                          (__gm__ uint8_t*)st, p);
        Check(aclrtSynchronizeStream(stream), "sync");
    }
    static int64_t buf[8 * 64];
    for (int32_t r = 0; r < reps; ++r) {
        p.srcOffset = (r % 16) * perLaunch;
        mix_kernel<<<blocks, 0, stream>>>((__gm__ uint8_t*)src, (__gm__ uint8_t*)dst,
                                          (__gm__ uint8_t*)st, p);
        Check(aclrtSynchronizeStream(stream), "sync");
        Check(aclrtMemcpy(buf, blocks * 8 * sizeof(int64_t), st,
                          blocks * 8 * sizeof(int64_t), ACL_MEMCPY_DEVICE_TO_HOST), "cp");
        for (int32_t c = 0; c < blocks; ++c) {
            fprintf(f, "%d,%d,%d,%d,%d,%lld,%lld\n", p.iters, p.sync, blocks, r, c,
                    (long long)buf[c * 8], (long long)buf[c * 8 + 1]);
        }
    }
    fclose(f);
    fprintf(stderr, "[host] iters=%d sync=%d work=%d blocks=%d reps=%d\n", p.iters, p.sync, p.work, blocks, reps);
    aclrtFree(src); aclrtFree(dst); aclrtFree(st);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
