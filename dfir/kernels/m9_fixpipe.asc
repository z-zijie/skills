// m9_fixpipe -- calibrate Fixpipe (L0C -> GM) versus output tile size.
//
// M2 measured fixpipe at 0.48-0.54us and I concluded it was a constant per-launch
// cost. M4 then showed 2.24us for a 2x larger output tile, so that conclusion was
// wrong: M2 varied the Mmad count but kept the output tile fixed, so it could
// never see the size dependence.
//
// This kernel does ONE Mmad of variable M,N and one Fixpipe store of the result,
// sweeping the output tile so fixpipe time can be fitted against elements.
#include <cstdio>
#include <cstdlib>
#include "acl/acl.h"
#include "tensor_api/tensor.h"
#include "basic_api/kernel_basic_intf.h"
#include "basic_api/kernel_operator_block_sync_intf.h"

using namespace AscendC;
using namespace AscendC::Te;

template <uint32_t M, uint32_t K, uint32_t N>
__global__ __cube__ void fix_kernel(__gm__ half* a, __gm__ half* b, __gm__ float* c)
{
    InitSocState();
    uint32_t blk = GetBlockIdx();

    auto gmA = MakeTensor(MakeMemPtr(a), MakeFrameLayout<NDExtLayoutPtn>(M * 32, K));
    auto gmB = MakeTensor(MakeMemPtr(b), MakeFrameLayout<NDExtLayoutPtn>(K, N));
    auto gmC = MakeTensor(MakeMemPtr(c), MakeFrameLayout<NDExtLayoutPtn>(M * 32, N));

    auto globalA = gmA.Slice(MakeCoord(blk * M, 0), MakeShape(M, K));
    auto globalB = gmB.Slice(MakeCoord(0, 0), MakeShape(K, N));
    auto globalC = gmC.Slice(MakeCoord(blk * M, 0), MakeShape(M, N));

    auto l1A = MakeFrameLayout<NZLayoutPtn>(M, K);
    auto l1B = MakeFrameLayout<NZLayoutPtn>(K, N);
    auto l0A = MakeFrameLayout<NZLayoutPtn>(M, K);
    auto l0B = MakeFrameLayout<ZNLayoutPtn>(K, N);
    auto l0C = MakeFrameLayout<NZLayoutPtn>(M, N);

    __cbuf__ half bA[M * K];
    __cbuf__ half bB[K * N];
    __ca__ half aA[M * K];
    __cb__ half aB[K * N];
    __cc__ float aC[M * N];

    auto tA = MakeTensor(MakeMemPtr(bA), l1A);
    auto tB = MakeTensor(MakeMemPtr(bB), l1B);
    auto uA = MakeTensor(MakeMemPtr(aA), l0A);
    auto uB = MakeTensor(MakeMemPtr(aB), l0B);
    auto uC = MakeTensor(MakeMemPtr(aC), l0C);

    auto cG2L1 = MakeCopy(CopyGM2L1{}, CopyGM2L1TraitDefault{});
    auto cL12A = MakeCopy(CopyL12L0A{}, CopyL12L0ATraitDefault{});
    auto cL12B = MakeCopy(CopyL12L0B{}, CopyL12L0BTraitDefault{});
    auto cFix = MakeCopy(CopyL0C2GM{}, CopyL0C2GMTraitDefault{});
    auto mmad = MakeMmad(MmadOperation{}, MmadTraitDefault{});

    Mutex::Lock<PIPE_MTE2>(0);
    Copy(cG2L1, tA, globalA);
    Copy(cG2L1, tB, globalB);
    Mutex::Unlock<PIPE_MTE2>(0);
    Mutex::Lock<PIPE_MTE1>(0);
    Copy(cL12A, uA, tA);
    Copy(cL12B, uB, tB);
    Mutex::Unlock<PIPE_MTE1>(0);
    Mutex::Lock<PIPE_M>(0);
    AscendC::Te::MmadParams para{M, N, K, 0, true};
    Mmad(mmad.with(para), uC, uA, uB);
    Mutex::Unlock<PIPE_M>(0);
    Mutex::Lock<PIPE_FIX>(0);
    Copy(cFix, globalC, uC);
    Mutex::Unlock<PIPE_FIX>(0);
}

static void Check(aclError e, const char* w)
{
    if (e != ACL_SUCCESS) { fprintf(stderr, "ACL %d at %s\n", (int)e, w); exit(1); }
}

int main(int argc, char** argv)
{
    if (argc < 3) { fprintf(stderr, "usage: %s <out.csv> <blocks> [0=128x128,1=128x256,2=256x256]\n", argv[0]); return 2; }
    const char* out = argv[1];
    int32_t blocks = atoi(argv[2]);

    Check(aclInit(nullptr), "aclInit");
    Check(aclrtSetDevice(0), "setDevice");
    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "createStream");

    // three output tiles, K fixed: 128x128, 128x256, 256x256 (16K/32K/64K elems)
    const int64_t aB_ = 256 * 256 * 2, bB_ = 256 * 256 * 2, cB_ = 256 * 256 * 4;
    void *a = nullptr, *b = nullptr, *c = nullptr;
    Check(aclrtMalloc(&a, aB_, ACL_MEM_MALLOC_HUGE_FIRST), "a");
    Check(aclrtMalloc(&b, bB_, ACL_MEM_MALLOC_HUGE_FIRST), "b");
    Check(aclrtMalloc(&c, cB_, ACL_MEM_MALLOC_HUGE_FIRST), "c");
    Check(aclrtMemset(a, aB_, 0, aB_), "ma");
    Check(aclrtMemset(b, bB_, 0, bB_), "mb");
    Check(aclrtMemset(c, cB_, 0, cB_), "mc");

    int32_t tile = argc > 3 ? atoi(argv[3]) : 0;
    FILE* f = fopen(out, "w");
    fprintf(f, "tile,blocks\n");
    for (int32_t r = 0; r < 5; ++r) {
        if (tile == 0) fix_kernel<128, 256, 128><<<blocks, 0, stream>>>((__gm__ half*)a, (__gm__ half*)b, (__gm__ float*)c);
        else if (tile == 1) fix_kernel<128, 256, 256><<<blocks, 0, stream>>>((__gm__ half*)a, (__gm__ half*)b, (__gm__ float*)c);
        else fix_kernel<256, 256, 256><<<blocks, 0, stream>>>((__gm__ half*)a, (__gm__ half*)b, (__gm__ float*)c);
        Check(aclrtSynchronizeStream(stream), "sync");
        fprintf(f, "%d,%d\n", tile, blocks);
    }
    fclose(f);
    fprintf(stderr, "[host] blocks=%d\n", blocks);
    aclrtFree(a); aclrtFree(b); aclrtFree(c);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
