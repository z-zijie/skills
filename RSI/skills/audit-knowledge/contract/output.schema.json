{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsi/skills/audit-knowledge/output.schema.json",
  "title": "audit-knowledge output",
  "description": "Mechanical findings over the knowledge stores plus demotion, retirement and merge proposals. Each proposal matches schemas/proposal.schema.json (shape inlined) and names the gate that would have to accept it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "today",
    "findings",
    "proposals",
    "counts",
    "health"
  ],
  "properties": {
    "today": {
      "type": "string"
    },
    "stores_audited": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "integer",
          "minimum": 0
        },
        "antipatterns": {
          "type": "integer",
          "minimum": 0
        },
        "patterns": {
          "type": "integer",
          "minimum": 0
        },
        "conjectures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "entry",
          "detail",
          "severity",
          "proposal"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "conflict",
              "stale",
              "thin_evidence",
              "no_mechanism",
              "unbound_metric",
              "legacy_metric",
              "orphan_evidence",
              "missed_counterexample"
            ]
          },
          "entry": {
            "type": "string",
            "minLength": 1,
            "description": "Entry id or path the finding is about."
          },
          "detail": {
            "type": "string",
            "minLength": 10
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "proposal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "action",
              "target",
              "gate"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "rule",
                  "pattern",
                  "antipattern",
                  "conjecture",
                  "threshold"
                ]
              },
              "action": {
                "type": "string",
                "enum": [
                  "demote",
                  "retire",
                  "merge",
                  "narrow_scope",
                  "fix_metric",
                  "annotate",
                  "require_mechanism",
                  "close"
                ]
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "gate": {
                "type": "string",
                "enum": [
                  "human_only",
                  "replay_dev_holdout",
                  "tighten_only_replay",
                  "offline_ledger_replay",
                  "unit_tests_plus_replay",
                  "mechanical"
                ]
              },
              "to_status": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  null,
                  "conjecture",
                  "candidate",
                  "established",
                  "under_review",
                  "deprecated"
                ]
              },
              "reason": {
                "type": "string"
              },
              "group": {
                "type": "string",
                "description": "Set when several findings collapse into one proposal, e.g. a merge target."
              }
            }
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "action",
          "target",
          "gate",
          "entries",
          "rationale",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^P-[0-9]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "rule",
              "pattern",
              "antipattern",
              "conjecture",
              "threshold"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "demote",
              "retire",
              "merge",
              "narrow_scope",
              "fix_metric",
              "annotate",
              "require_mechanism",
              "close"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "enum": [
              "human_only",
              "replay_dev_holdout",
              "tighten_only_replay",
              "offline_ledger_replay",
              "unit_tests_plus_replay",
              "mechanical"
            ]
          },
          "to_status": {
            "type": [
              "string",
              "null"
            ]
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 20
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "needs_human"
            ]
          },
          "group": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One entry per finding that feeds this proposal; `rationale` joins them."
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "proposals": {
          "type": "integer",
          "minimum": 0
        },
        "mechanical": {
          "type": "integer",
          "minimum": 0
        },
        "needs_replay": {
          "type": "integer",
          "minimum": 0
        },
        "by_kind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "by_severity": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "established_rules": {
          "type": "integer",
          "minimum": 0
        },
        "rules_with_evidence_in_window": {
          "type": "integer",
          "minimum": 0
        },
        "mean_evidence_per_rule": {
          "type": [
            "number",
            "null"
          ]
        },
        "deprecated_share": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
