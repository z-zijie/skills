{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsi/skills/edit-scaffold/output.schema.json",
  "title": "edit-scaffold output",
  "description": "One scaffold-change proposal with its branch, its change note and its replay plan. The proposal matches schemas/proposal.schema.json (shape inlined); the replay plan is the budget replay-benchmark must honour.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal", "target_kind", "branch", "change_note", "replay", "refusals", "ready_for_replay"],
  "properties": {
    "target_kind": {
      "type": "string",
      "enum": ["playbook", "skill_strategy", "pattern", "threshold", "verifier_check", "script", "model_routing", "contract"]
    },
    "proposal": {
      "type": "object",
      "description": "A proposal as defined by schemas/proposal.schema.json.",
      "additionalProperties": false,
      "required": ["id", "kind", "title", "rationale", "target", "status", "gate"],
      "properties": {
        "id": {"type": "string", "pattern": "^P-[0-9]+$"},
        "kind": {"type": "string", "enum": ["rule", "pattern", "antipattern", "playbook", "skill_strategy", "threshold", "verifier_check", "microbench", "model_routing", "contract"]},
        "title": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 20},
        "target": {"type": "string", "minLength": 1},
        "diff": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["draft", "replay_pending", "merged", "rolled_back", "rejected", "needs_human"]},
        "gate": {"type": "string", "enum": ["human_only", "replay_dev_holdout", "tighten_only_replay", "offline_ledger_replay", "unit_tests_plus_replay", "mechanical"]},
        "author": {"type": "string"}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "files_changed", "commit_message"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "base": {"type": "string"},
        "files_changed": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
        "commit_message": {"type": "string", "minLength": 10}
      }
    },
    "change_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["one_change", "why_this_cluster", "what_changed", "expected_effect", "revert"],
      "properties": {
        "one_change": {"type": "boolean", "const": true},
        "why_this_cluster": {"type": "string", "minLength": 20},
        "what_changed": {"type": "string", "minLength": 10},
        "what_did_not_change": {"type": "string"},
        "expected_effect": {"type": "string"},
        "revert": {"type": "string", "minLength": 5}
      }
    },
    "replay": {
      "type": "object",
      "description": "The plan replay-benchmark runs. Two-stage screening, fixed budget, at least three repeats per configuration.",
      "additionalProperties": false,
      "required": ["screening", "experiments_per_operator", "repeats", "gate"],
      "properties": {
        "screening": {"type": "string", "enum": ["two_stage_screen", "offline_ledger", "full"]},
        "stage_1_offline_ledger": {"type": "boolean"},
        "stage_1_operators": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
        "stage_2_operators": {"type": "array", "items": {"type": "string"}},
        "experiments_per_operator": {"type": "integer", "minimum": 1},
        "repeats": {"type": "integer", "minimum": 3},
        "from_checkpoint": {"type": "boolean"},
        "holdout_visible_to": {"type": "string", "const": "replay_judge"},
        "decision_rule": {"type": "string"},
        "gate": {"type": "string", "enum": ["human_only", "replay_dev_holdout", "tighten_only_replay", "offline_ledger_replay", "unit_tests_plus_replay", "mechanical"]}
      }
    },
    "refusals": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Empty when the change may go to replay. Each entry names the rule that refused it."
    },
    "ready_for_replay": {"type": "boolean"}
  }
}
