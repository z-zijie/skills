// m1_model -- calibrate the remaining AIV pipes (MTE3 and VEC) with hardware
// counters, the same way MTE2 was calibrated in M0.
//
// Mode 1  MTE3 only : one MTE2 load fills UB, then K times DataCopyPad UB->GM.
//                     MTE2 is amortised over K, so the K-dependent term is MTE3.
// Mode 2  VEC only  : one MTE2 load, then K in-place vector Add passes over N
//                     elements. MTE2/MTE3 amortised, so the slope is VEC cost.
// Mode 3  pipeline  : K iterations of load -> compute -> store, i.e. a real
//                     DataFlow with all three pipes overlapping.
//
// Reported by msprof (PipeUtilization): aiv_total_cycles, aiv_mte2_time,
// aiv_vec_time, aiv_mte3_time, so each pipe's share can be cross-checked.
#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"

using namespace AscendC;

constexpr int64_t kBufBytes = 100 * 1024;
constexpr int32_t kBufElems = kBufBytes / sizeof(float);
constexpr int64_t kSlotBytes = 1024 * 1024;
constexpr int32_t kStamps = 2;

struct Params {
    int64_t srcOffsetBytes;
    int32_t mode;     // 1=MTE3, 2=VEC, 3=pipeline
    int32_t iters;    // K
    int32_t elems;    // N elements per VEC pass
};

__global__ __aicore__ __vector__ void m1_kernel(GM_ADDR src, GM_ADDR dst, GM_ADDR stamps, Params p)
{
    int64_t blk = GetBlockIdx();
    const int64_t base = p.srcOffsetBytes + blk * kSlotBytes;

    TPipe pipe;
    TBuf<TPosition::VECIN> ub0;
    TBuf<TPosition::VECIN> ub1;
    TBuf<TPosition::VECIN> ubS;
    pipe.InitBuffer(ub0, kBufBytes);
    pipe.InitBuffer(ub1, kBufBytes);
    pipe.InitBuffer(ubS, kStamps * sizeof(int64_t));
    LocalTensor<float> a = ub0.Get<float>();
    LocalTensor<float> b = ub1.Get<float>();

    DataCopyPadExtParams<float> pad{false, 0, 0, 0};
    DataCopyExtParams cp{1, static_cast<uint32_t>(kBufBytes), 0, 0, 0};
    DataCopyExtParams cpOut{1, static_cast<uint32_t>(kBufBytes), 0, 0, 0};

    int64_t t0 = GetSystemCycle();

    if (p.mode == 1) {
        // fill UB once, then K stores
        GlobalTensor<float> gsrc;
        gsrc.SetGlobalBuffer((__gm__ float*)((GM_ADDR)src + base), kBufElems);
        DataCopyPad(a, gsrc, cp, pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        // Two alternating source buffers, so consecutive stores are not forced
        // through one UB bank (which produced a bimodal 537k/1.75M result).
        for (int32_t i = 0; i < p.iters; ++i) {
            GlobalTensor<float> gdst;
            gdst.SetGlobalBuffer((__gm__ float*)((GM_ADDR)dst + base) + i * kBufElems, kBufElems);
            DataCopyPad(gdst, (i & 1) ? b : a, cpOut);
        }
        SetFlag<HardEvent::MTE3_S>(EVENT_ID1);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID1);
    } else if (p.mode == 2) {
        // fill UB once, then K vector passes
        GlobalTensor<float> gsrc;
        gsrc.SetGlobalBuffer((__gm__ float*)((GM_ADDR)src + base), kBufElems);
        DataCopyPad(a, gsrc, cp, pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
        DataCopyPad(b, gsrc, cp, pad);
        SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
        WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
        const int32_t n = p.elems > 0 ? p.elems : kBufElems;
        for (int32_t i = 0; i < p.iters; ++i) {
            Add(a, a, b, n);
        }
    } else {
        // pipeline: load -> compute -> store, K times
        const int32_t n = p.elems > 0 ? p.elems : kBufElems;
        for (int32_t i = 0; i < p.iters; ++i) {
            GlobalTensor<float> gsrc;
            gsrc.SetGlobalBuffer((__gm__ float*)((GM_ADDR)src + base) + i * kBufElems, kBufElems);
            DataCopyPad(a, gsrc, cp, pad);
            DataCopyPad(b, gsrc, cp, pad);
            SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
            Add(a, a, b, n);
            SetFlag<HardEvent::V_MTE3>(EVENT_ID2);
            WaitFlag<HardEvent::V_MTE3>(EVENT_ID2);
            GlobalTensor<float> gdst;
            gdst.SetGlobalBuffer((__gm__ float*)((GM_ADDR)dst + base) + i * kBufElems, kBufElems);
            DataCopyPad(gdst, a, cpOut);
            SetFlag<HardEvent::MTE3_S>(EVENT_ID1);
            WaitFlag<HardEvent::MTE3_S>(EVENT_ID1);
        }
    }

    int64_t t1 = GetSystemCycle();
    LocalTensor<int64_t> ls = ubS.Get<int64_t>();
    ls.SetValue(0, t0);
    ls.SetValue(1, t1);
    PipeBarrier<PIPE_ALL>();
    GlobalTensor<int64_t> gs;
    gs.SetGlobalBuffer((__gm__ int64_t*)stamps + blk * kStamps, kStamps);
    DataCopyExtParams scp{1, static_cast<uint32_t>(kStamps * sizeof(int64_t)), 0, 0, 0};
    DataCopyPad(gs, ls, scp);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID7);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID7);
}

static void Check(aclError e, const char* what)
{
    if (e != ACL_SUCCESS) {
        std::fprintf(stderr, "ACL error %d at %s\n", (int)e, what);
        std::exit(1);
    }
}

// usage: m1_model pointcsv <out.csv> <mode> <iters> <elems> <blocks> <reps>
int main(int argc, char** argv)
{
    if (argc < 8) {
        std::fprintf(stderr, "usage: %s pointcsv <out.csv> <mode> <iters> <elems> <blocks> <reps>\n", argv[0]);
        return 2;
    }
    const char* outPath = argv[2];
    Params base;
    base.srcOffsetBytes = 0;
    base.mode = std::atoi(argv[3]);
    base.iters = std::atoi(argv[4]);
    base.elems = std::atoi(argv[5]);
    int32_t wantBlocks = std::atoi(argv[6]);
    int32_t reps = std::atoi(argv[7]);

    const char* offArg = std::getenv("MTE2_OFFSET_SLOT");
    int64_t offsetSlot = offArg ? std::atoll(offArg) : 0;

    Check(aclInit(nullptr), "aclInit");
    Check(aclrtSetDevice(0), "setDevice");
    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "createStream");

    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    int32_t aivNum = plat->GetCoreNumAiv();
    int32_t blocks = (wantBlocks > 0 && wantBlocks < aivNum) ? wantBlocks : aivNum;

    int64_t perLaunch = int64_t(aivNum) * kSlotBytes;
    int64_t slots = std::min<int64_t>(4096, int64_t(reps) + 16);
    int64_t srcBytes = perLaunch * slots;
    void* srcDev = nullptr;
    void* dstDev = nullptr;
    void* stampDev = nullptr;
    Check(aclrtMalloc(&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc src");
    Check(aclrtMalloc(&dstDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc dst");
    Check(aclrtMalloc(&stampDev, aivNum * kStamps * sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST), "malloc stamps");
    Check(aclrtMemset(srcDev, srcBytes, 0, srcBytes), "memset src");
    Check(aclrtMemset(dstDev, srcBytes, 0, srcBytes), "memset dst");

    std::vector<int64_t> stamps(aivNum * kStamps, 0);
    FILE* f = std::fopen(outPath, "w");
    if (!f) {
        std::fprintf(stderr, "cannot open %s\n", outPath);
        return 1;
    }
    std::fprintf(f, "launch,core,t0,t1\n");

    int64_t launchIdx = 0;
    auto runOnce = [&](bool record) {
        base.srcOffsetBytes = ((launchIdx + offsetSlot) % slots) * perLaunch;
        ++launchIdx;
        m1_kernel<<<blocks, 0, stream>>>((__gm__ uint8_t*)srcDev, (__gm__ uint8_t*)dstDev,
                                         (__gm__ uint8_t*)stampDev, base);
        Check(aclrtSynchronizeStream(stream), "sync");
        Check(aclrtMemcpy(stamps.data(), stamps.size() * sizeof(int64_t), stampDev,
                          stamps.size() * sizeof(int64_t), ACL_MEMCPY_DEVICE_TO_HOST), "memcpy stamps");
        if (!record) return;
        for (int32_t c = 0; c < blocks; ++c) {
            std::fprintf(f, "%lld,%d,%lld,%lld\n", (long long)(launchIdx - 1), c,
                         (long long)stamps[c * kStamps], (long long)stamps[c * kStamps + 1]);
        }
    };

    for (int32_t r = 0; r < 6; ++r) runOnce(false);
    for (int32_t r = 0; r < reps; ++r) runOnce(true);
    std::fclose(f);
    std::fprintf(stderr, "[host] mode=%d iters=%d elems=%d blocks=%d reps=%d window=%.2fGB\n",
                 base.mode, base.iters, base.elems, blocks, reps, double(srcBytes) / 1e9);

    aclrtFree(srcDev);
    aclrtFree(dstDev);
    aclrtFree(stampDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
