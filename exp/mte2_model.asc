// mte2_model -- parameter sweep for a queueing model of MTE2 (GM->UB DataCopyPad)
// on Ascend950PR (dav-3510).
//
// Per AIV core, for `copies` K back-to-back DataCopyPads of `bytes` S each:
//
//   t_begin
//   for k in 0..K-1:
//       DataCopyPad copy_k (S bytes, GM->UB)
//       SetFlag<HardEvent::MTE2_S>(EVENT_ID_k)   // fires on data arrival
//       t_issue[k]
//   for k in 0..K-1:
//       WaitFlag<MTE2_S>(EVENT_ID_k)
//       t_done[k]                                 -> C_k = t_done[k] - t_begin
//   t_end
//
// Stamps written per core: t_begin, t_issue[0..7], t_done[0..7], blockIdx (18 int64).
// C_k is the completion time of the k-th copy: the quantity the model predicts.
//
// Driven one data point per process (bench pointcsv) so no cross-point history
// can leak in; every core reads its own slice of a large rotating window so all
// copies are cold HBM reads.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <algorithm>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"

using namespace AscendC;

constexpr int32_t kMaxK = 8;
constexpr int32_t kStamps = 2 + 2 * kMaxK + 1;   // begin, issue[8], done[8], blockIdx
constexpr int64_t kSlotBytes = 1024 * 1024;      // per-core source slice
// Source window must exceed L2 (128MB) across a whole run, otherwise a later
// launch re-reads data an earlier launch already cached and the measurement
// silently becomes an L2 measurement. Sized from the number of launches.
constexpr int64_t kSrcSlotsMax = 4096;

struct Params {
    int64_t srcOffsetBytes;
    int32_t copies;    // K
    int32_t bytes;     // S per copy
};

__global__ __aicore__ __vector__ void mte2_model_kernel(GM_ADDR src, GM_ADDR stamps, Params p)
{
    int64_t blk = GetBlockIdx();
    const int64_t coreBase = p.srcOffsetBytes + blk * kSlotBytes;

    // UB is 248KB; give every copy its own buffer, respecting the 100KB map case.
    TPipe pipe;
    TBuf<TPosition::VECIN> ub[kMaxK];
    TBuf<TPosition::VECIN> ubS;
    for (int32_t k = 0; k < p.copies; ++k) {
        pipe.InitBuffer(ub[k], p.bytes);
    }
    pipe.InitBuffer(ubS, kStamps * sizeof(int64_t));

    DataCopyPadExtParams<float> pp{false, 0, 0, 0};

    int64_t tBegin = GetSystemCycle();
    int64_t tIssue[kMaxK];
    int64_t tDone[kMaxK];
    for (int32_t k = 0; k < p.copies; ++k) {
        GlobalTensor<float> g;
        g.SetGlobalBuffer((__gm__ float*)((GM_ADDR)src + coreBase + int64_t(k) * p.bytes),
                          p.bytes / sizeof(float));
        LocalTensor<float> dst = ub[k].Get<float>();
        DataCopyExtParams cp{1, static_cast<uint32_t>(p.bytes), 0, 0, 0};
        DataCopyPad(dst, g, cp, pp);
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0 + k);
        tIssue[k] = GetSystemCycle();
    }
    for (int32_t k = 0; k < p.copies; ++k) {
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID0 + k);
        tDone[k] = GetSystemCycle();
    }
    int64_t tEnd = GetSystemCycle();

    LocalTensor<int64_t> ls = ubS.Get<int64_t>();
    ls.SetValue(0, tBegin);
    for (int32_t k = 0; k < kMaxK; ++k) {
        ls.SetValue(1 + k, k < p.copies ? tIssue[k] : 0);
    }
    for (int32_t k = 0; k < kMaxK; ++k) {
        ls.SetValue(1 + kMaxK + k, k < p.copies ? tDone[k] : 0);
    }
    ls.SetValue(1 + 2 * kMaxK, tEnd);
    ls.SetValue(2 + 2 * kMaxK, blk);
    PipeBarrier<PIPE_ALL>();

    GlobalTensor<int64_t> gs;
    gs.SetGlobalBuffer((__gm__ int64_t*)stamps + blk * kStamps, kStamps);
    DataCopyExtParams scp{1, static_cast<uint32_t>(kStamps * sizeof(int64_t)), 0, 0, 0};
    DataCopyPad(gs, ls, scp);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID7);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID7);
}

static void Check(aclError e, const char* what)
{
    if (e != ACL_SUCCESS) {
        std::fprintf(stderr, "ACL error %d at %s\n", (int)e, what);
        std::exit(1);
    }
}

// usage: mte2_model pointcsv <out.csv> <copies> <bytes> <blocks> <reps>
int main(int argc, char** argv)
{
    if (argc < 7) {
        std::fprintf(stderr, "usage: %s pointcsv <out.csv> <copies> <bytes> <blocks> <reps>\n", argv[0]);
        return 2;
    }
    const char* outPath = argv[2];
    Params base;
    base.srcOffsetBytes = 0;
    base.copies = std::atoi(argv[3]);
    base.bytes = std::atoi(argv[4]);
    int32_t wantBlocks = std::atoi(argv[5]);
    int32_t reps = std::atoi(argv[6]);

    const char* offArg = std::getenv("MTE2_OFFSET_SLOT");
    int64_t offsetSlot = offArg ? std::atoll(offArg) : 0;

    Check(aclInit(nullptr), "aclInit");
    Check(aclrtSetDevice(0), "setDevice");
    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "createStream");

    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    int32_t aivNum = plat->GetCoreNumAiv();
    int32_t blocks = (wantBlocks > 0 && wantBlocks < aivNum) ? wantBlocks : aivNum;

    int64_t perLaunch = int64_t(aivNum) * kSlotBytes;
    // one fresh window per recorded launch plus warmup; never wrap within a run
    int64_t slots = std::min<int64_t>(kSrcSlotsMax, int64_t(reps) + 16);
    int64_t srcBytes = perLaunch * slots;
    void* srcDev = nullptr;
    void* stampDev = nullptr;
    Check(aclrtMalloc(&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc src");
    Check(aclrtMalloc(&stampDev, aivNum * kStamps * sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST), "malloc stamps");
    Check(aclrtMemset(srcDev, srcBytes, 0, srcBytes), "memset src");
    std::fprintf(stderr, "[host] window=%.2fGB slots=%lld (L2=128MB)\n",
                 double(srcBytes) / 1e9, (long long)slots);

    std::vector<int64_t> stamps(aivNum * kStamps, 0);
    FILE* f = std::fopen(outPath, "w");
    if (!f) {
        std::fprintf(stderr, "cannot open %s\n", outPath);
        return 1;
    }
    std::fprintf(f, "launch,core,t_begin");
    for (int32_t k = 0; k < kMaxK; ++k) std::fprintf(f, ",t_issue%d", k);
    for (int32_t k = 0; k < kMaxK; ++k) std::fprintf(f, ",t_done%d", k);
    std::fprintf(f, "\n");

    int64_t launchIdx = 0;
    auto runOnce = [&](bool record) {
        // rotate the source window so every copy is a cold HBM read
        base.srcOffsetBytes = ((launchIdx + offsetSlot) % slots) * perLaunch;
        ++launchIdx;
        mte2_model_kernel<<<blocks, 0, stream>>>((__gm__ uint8_t*)srcDev, (__gm__ uint8_t*)stampDev, base);
        Check(aclrtSynchronizeStream(stream), "sync");
        Check(aclrtMemcpy(stamps.data(), stamps.size() * sizeof(int64_t), stampDev,
                          stamps.size() * sizeof(int64_t), ACL_MEMCPY_DEVICE_TO_HOST),
              "memcpy stamps");
        if (!record) {
            return;
        }
        for (int32_t c = 0; c < blocks; ++c) {
            const int64_t* s = &stamps[c * kStamps];
            std::fprintf(f, "%lld,%d,%lld", (long long)(launchIdx - 1), c, (long long)s[0]);
            for (int32_t k = 0; k < kMaxK; ++k) std::fprintf(f, ",%lld", (long long)s[1 + k]);
            for (int32_t k = 0; k < kMaxK; ++k) std::fprintf(f, ",%lld", (long long)s[1 + kMaxK + k]);
            std::fprintf(f, "\n");
        }
    };

    for (int32_t r = 0; r < 6; ++r) runOnce(false);   // warm process/clock/allocator
    for (int32_t r = 0; r < reps; ++r) runOnce(true);
    std::fclose(f);
    std::fprintf(stderr, "[host] copies=%d bytes=%d blocks=%d reps=%d launches=%lld\n",
                 base.copies, base.bytes, blocks, reps, (long long)launchIdx);

    aclrtFree(srcDev);
    aclrtFree(stampDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
