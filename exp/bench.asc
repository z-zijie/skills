// noop_mte2 -- Ascend950PR (dav-3510) MTE2 bus-contention experiment.
//
// Question: if two MTE2 DataCopyPad (GM->UB, 100KB each) are issued back to back
// on all 56 AIV cores, do their bus packets interleave so that the first one is
// slowed down? Can a scalar nop ladder inserted between the two issues let the
// first one finish earlier, and what does that cost in kernel time?
//
// Modes (one kernel launch per data point, 56 cores per launch):
//   1 two100k   copy1(100KB); nop^n; copy2(100KB)         -> sweep n
//   0 one100k   copy1(100KB); nop^n; (nothing)            -> control, same ladder
//   2 ablate    copy1(100KB); copy2(c bytes), n=0         -> sweep c (traffic dose)
//   3 pipeline  double-buffered prefetch of K=8 x 100KB tiles, nop^n per tile
//   4 one200k   one 200KB copy (traffic control for two 100KB copies)
//   5 three100k copy1; nop^n; copy2; copy3                -> sweep n, 3-way contention
//
// Time base: SYS_CNT via AscendC::GetSystemCycle(), one shared counter, read on
// AIV. Completion of an MTE2 is observed with SetFlag/WaitFlag<HardEvent::MTE2_S>
// so the timestamp marks data arrival, not issue.
//
// Stamps written per core: t_begin, t_issue1, t_end1, t_issue2, t_end2, blockIdx
//   T1   = t_end1 - t_begin    (copy1 issue -> copy1 complete)
//   W2   = t_issue2 - t_issue1 (real delay produced by the nop ladder)
//   SPAN = t_end2 - t_begin    (whole per-core sequence; ~ kernel wall time)
//
// Fast driver reads stamps in bulk (CSV). `--perf` driver runs a single point
// once so msprof can report the kernel's own duration for the same point.
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"

using namespace AscendC;

constexpr int64_t k100K = 100 * 1024;
constexpr int64_t k72K = 72 * 1024;   // 3-way mode: 3 x 72KB fits in 248KB UB
constexpr int64_t kSlotBytes = 1024 * 1024;   // per-core window slice (>= 800KB for pipeline)
constexpr int32_t kStamps = 6;
constexpr int64_t kSrcSlots = 40;

struct Params {
    int64_t srcOffsetBytes;
    int32_t mode;
    int32_t nops;
    int32_t copyBytes;   // mode 2: size of copy2
    int32_t tiles;       // mode 3: number of 100KB tiles
};

enum : int32_t { kTwo = 1, kOne = 0, kAblate = 2, kPipeline = 3, kOne200 = 4, kThree = 5, kClock = 6 };

__aicore__ inline void NopN(int32_t n)
{
    for (int32_t i = 0; i < n; ++i) {
        __asm__ __volatile__("nop");
    }
}

__aicore__ inline void Copy1(GM_ADDR src, int64_t byteOff, LocalTensor<float>& dst, int32_t bytes)
{
    GlobalTensor<float> g;
    g.SetGlobalBuffer((__gm__ float*)((GM_ADDR)src + byteOff), bytes / sizeof(float));
    DataCopyExtParams cp{1, static_cast<uint32_t>(bytes), 0, 0, 0};
    DataCopyPadExtParams<float> pp{false, 0, 0, 0};
    DataCopyPad(dst, g, cp, pp);
}

__global__ __aicore__ __vector__ void noop_mte2_kernel(GM_ADDR src, GM_ADDR stamps, Params p)
{
    int64_t blk = GetBlockIdx();
    const int64_t coreBase = p.srcOffsetBytes + blk * kSlotBytes;

    const int64_t bufBytes = (p.mode == kThree) ? k72K : k100K;
    TPipe pipe;
    TBuf<TPosition::VECIN> ub0;
    TBuf<TPosition::VECIN> ub1;
    TBuf<TPosition::VECIN> ub2;
    TBuf<TPosition::VECIN> ubS;
    pipe.InitBuffer(ub0, bufBytes);
    pipe.InitBuffer(ub1, bufBytes);
    if (p.mode == kThree) {
        pipe.InitBuffer(ub2, bufBytes);
    }
    pipe.InitBuffer(ubS, kStamps * sizeof(int64_t));
    LocalTensor<float> l0 = ub0.Get<float>();
    LocalTensor<float> l1 = ub1.Get<float>();
    LocalTensor<float> l2 = ub2.Get<float>();

    int64_t t0 = GetSystemCycle();
    int64_t t1 = 0, t2 = 0, t3 = 0, t4 = 0;

    if (p.mode == kClock) {
        // Pure scalar ladder: SYS_CNT delta vs msprof kernel duration gives
        // ticks-per-ns and ns-per-nop. No MTE2 at all.
        int64_t a = GetSystemCycle();
        NopN(p.nops);
        int64_t b = GetSystemCycle();
        t0 = a;
        t1 = a;
        t2 = a;
        t3 = b;
        t4 = b;
    } else if (p.mode == kPipeline) {
        // Double-buffered prefetch: keep up to 2 MTE2 in flight, nop^n between issues.
        const int32_t K = p.tiles;
        for (int32_t i = 0; i < K; ++i) {
            int32_t slot = i & 1;
            int32_t ev = slot == 0 ? EVENT_ID0 : EVENT_ID1;
            if (i >= 2) {
                WaitFlag<HardEvent::MTE2_S>(ev);   // buffer i&1 has arrived -> reuse it
            }
            LocalTensor<float>& dst = slot == 0 ? l0 : l1;
            Copy1(src, coreBase + int64_t(i) * k100K, dst, int32_t(k100K));
            SetFlag<HardEvent::MTE2_S>(ev);
            if (i == 0) {
                t1 = GetSystemCycle();
            }
            NopN(p.nops);
        }
        WaitFlag<HardEvent::MTE2_S>(((K - 1) & 1) == 0 ? EVENT_ID0 : EVENT_ID1);
        t3 = GetSystemCycle();
        if (K >= 2) {
            WaitFlag<HardEvent::MTE2_S>(((K - 2) & 1) == 0 ? EVENT_ID0 : EVENT_ID1);
        }
        t4 = GetSystemCycle();
        t2 = t1;
    } else {
        int32_t c1 = (p.mode == kOne200) ? int32_t(2 * k100K)
                     : (p.mode == kThree ? int32_t(k72K) : int32_t(k100K));
        Copy1(src, coreBase, l0, c1);
        SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
        t1 = GetSystemCycle();
        NopN(p.nops);
        t2 = GetSystemCycle();
        int32_t c2 = 0;
        if (p.mode == kTwo) c2 = int32_t(k100K);
        if (p.mode == kThree) c2 = int32_t(k72K);
        if (p.mode == kAblate) c2 = p.copyBytes;
        if (c2 > 0) {
            Copy1(src, coreBase + c1, l1, c2);
            SetFlag<HardEvent::MTE2_S>(EVENT_ID1);
            if (p.mode == kThree) {
                Copy1(src, coreBase + c1 + c2, l2, int32_t(k72K));
                SetFlag<HardEvent::MTE2_S>(EVENT_ID3);
            }
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
            t3 = GetSystemCycle();
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID1);
            if (p.mode == kThree) {
                WaitFlag<HardEvent::MTE2_S>(EVENT_ID3);
            }
            t4 = GetSystemCycle();
        } else {
            WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
            t3 = GetSystemCycle();
            t4 = t3;
        }
    }

    LocalTensor<int64_t> ls = ubS.Get<int64_t>();
    ls.SetValue(0, t0);
    ls.SetValue(1, t1);
    ls.SetValue(2, t3);
    ls.SetValue(3, t2);
    ls.SetValue(4, t4);
    ls.SetValue(5, blk);
    PipeBarrier<PIPE_ALL>();
    GlobalTensor<int64_t> gs;
    gs.SetGlobalBuffer((__gm__ int64_t*)stamps + blk * kStamps, kStamps);
    DataCopyExtParams scp{1, static_cast<uint32_t>(kStamps * sizeof(int64_t)), 0, 0, 0};
    DataCopyPad(gs, ls, scp);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID7);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID7);
}

static void Check(aclError e, const char* what)
{
    if (e != ACL_SUCCESS) {
        std::fprintf(stderr, "ACL error %d at %s\n", (int)e, what);
        std::exit(1);
    }
}

struct Point {
    int32_t mode;
    int32_t nops;
    int32_t copyBytes;
    int32_t tiles;
};

static int64_t gOffsetSlot = 0;

int main(int argc, char** argv)
{
    // bench sweep <out.csv> [reps] [warmup] [blocks]
    // bench point <mode> <nops> <copyBytes> <tiles> [reps] [blocks]
    // bench pointcsv <out.csv> <mode> <nops> <copyBytes> <tiles> <blocks> <reps> [offsetSlot]
    const bool pointcsv = argc > 1 && std::strcmp(argv[1], "pointcsv") == 0;
    const bool sweep = argc > 1 && std::strcmp(argv[1], "sweep") == 0;
    const char* outPath = (sweep || pointcsv) && argc > 2 ? argv[2] : "/tmp/bench.csv";
    int32_t reps = sweep ? (argc > 3 ? std::atoi(argv[3]) : 12)
                   : pointcsv ? (argc > 8 ? std::atoi(argv[8]) : 5)
                   : (argc > 6 ? std::atoi(argv[6]) : 1);
    int32_t warmup = sweep ? (argc > 4 ? std::atoi(argv[4]) : 3) : 0;
    int32_t wantBlocks = 0;
    if (sweep && argc > 5) wantBlocks = std::atoi(argv[5]);
    if (pointcsv && argc > 7) wantBlocks = std::atoi(argv[7]);
    if (pointcsv && argc > 9) gOffsetSlot = std::atoi(argv[9]);
    if (!sweep && !pointcsv && argc > 7) wantBlocks = std::atoi(argv[7]);

    static const int32_t kNops[] = {0,  4,  8,   16,  24,  32,  48,  64,  80,  96,  112, 128, 144,
                                    160, 176, 192, 208, 224, 240, 256, 272, 288, 304, 320, 352,
                                    384, 400, 416, 448, 512, 768, 1024};
    const int32_t nNops = sizeof(kNops) / sizeof(kNops[0]);
    static const int32_t kC2[] = {1024, 4096, 16 * 1024, 32 * 1024, 50 * 1024, 75 * 1024, 100 * 1024};
    const int32_t nC2 = sizeof(kC2) / sizeof(kC2[0]);

    std::vector<Point> points;
    if (sweep) {
        for (int32_t i = 0; i < nNops; ++i) {
            points.push_back({kTwo, kNops[i], int32_t(k100K), 0});
            points.push_back({kOne, kNops[i], 0, 0});
        }
        for (int32_t i = 0; i < nC2; ++i) {
            points.push_back({kAblate, 0, kC2[i], 0});
        }
        points.push_back({kOne200, 0, int32_t(2 * k100K), 0});
        for (int32_t i = 0; i < nNops; ++i) {
            points.push_back({kPipeline, kNops[i], int32_t(k100K), 8});
        }
        for (int32_t i = 0; i < 12; ++i) {
            points.push_back({kThree, kNops[i], int32_t(k100K), 0});
        }
        for (int32_t i = 0; i < nNops; ++i) {
            points.push_back({kClock, kNops[i], 0, 0});
        }
    } else if (pointcsv) {
        points.push_back({std::atoi(argv[3]), std::atoi(argv[4]), std::atoi(argv[5]), std::atoi(argv[6])});
    } else {
        points.push_back({std::atoi(argv[2]), std::atoi(argv[3]), std::atoi(argv[4]), std::atoi(argv[5])});
    }

    Check(aclInit(nullptr), "aclInit");
    Check(aclrtSetDevice(0), "setDevice");
    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "createStream");

    auto plat = platform_ascendc::PlatformAscendCManager::GetInstance();
    int32_t aivNum = plat->GetCoreNumAiv();
    int32_t blocks = (wantBlocks > 0 && wantBlocks < aivNum) ? wantBlocks : aivNum;
    int64_t perLaunch = int64_t(aivNum) * kSlotBytes;
    int64_t srcBytes = perLaunch * kSrcSlots;
    std::fprintf(stderr, "[host] aiv=%d blocks=%d perLaunch=%.2fMB window=%.2fMB points=%d reps=%d\n", aivNum,
                 blocks, double(perLaunch) / 1e6, double(srcBytes) / 1e6, (int)points.size(), reps);

    void* srcDev = nullptr;
    void* stampDev = nullptr;
    Check(aclrtMalloc(&srcDev, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc src");
    Check(aclrtMalloc(&stampDev, aivNum * kStamps * sizeof(int64_t), ACL_MEM_MALLOC_HUGE_FIRST), "malloc stamps");
    Check(aclrtMemset(srcDev, srcBytes, 0, srcBytes), "memset src");

    std::vector<int64_t> stamps(aivNum * kStamps, 0);
    FILE* f = nullptr;
    if (sweep || pointcsv) {
        f = std::fopen(outPath, "w");
        if (!f) {
            std::fprintf(stderr, "cannot open %s\n", outPath);
            return 1;
        }
        std::fprintf(f,
                     "launch,idx,point,mode,nops,copybytes,tiles,blocks,core,t_begin,t_issue1,t_end1,t_issue2,t_end2\n");
    }

    int64_t launchIdx = 0;
    int64_t recIdx = 0;
    auto runPoint = [&](const Point& pt, int64_t ptIdx, bool record) {
        const int64_t slot = (launchIdx + gOffsetSlot) % kSrcSlots;
        Params p{slot * perLaunch, pt.mode, pt.nops, pt.copyBytes, pt.tiles};
        ++launchIdx;
        noop_mte2_kernel<<<blocks, 0, stream>>>((__gm__ uint8_t*)srcDev, (__gm__ uint8_t*)stampDev, p);
        Check(aclrtSynchronizeStream(stream), "sync");
        Check(aclrtMemcpy(stamps.data(), stamps.size() * sizeof(int64_t), stampDev,
                          stamps.size() * sizeof(int64_t), ACL_MEMCPY_DEVICE_TO_HOST),
              "memcpy stamps");
        if (!record) {
            return;
        }
        for (int32_t c = 0; c < blocks; ++c) {
            const int64_t* s = &stamps[c * kStamps];
            std::fprintf(f, "%lld,%lld,%lld,%d,%d,%d,%d,%d,%d,%lld,%lld,%lld,%lld,%lld\n", (long long)(launchIdx - 1),
                         (long long)recIdx, (long long)ptIdx, pt.mode, pt.nops, pt.copyBytes, pt.tiles, blocks, c,
                         (long long)s[0], (long long)s[1], (long long)s[2], (long long)s[3], (long long)s[4]);
        }
        ++recIdx;
    };

    if (pointcsv) {
        // warm the process/clock/allocator before the recorded launches; without
        // this each fresh process pays a cold-start penalty on its first launch
        for (int32_t r = 0; r < 6; ++r) {
            runPoint(points[0], 0, false);
        }
        for (int32_t r = 0; r < reps; ++r) {
            runPoint(points[0], 0, true);
        }
        std::fprintf(f, "# pointcsv mode %d nops %d blocks %d reps %d\n",
                     points[0].mode, points[0].nops, blocks, reps);
        std::fclose(f);
        std::fprintf(stderr, "[host] pointcsv done reps=%d\n", reps);
    } else if (sweep) {
        for (int32_t r = 0; r < warmup; ++r) {
            for (size_t i = 0; i < points.size(); ++i) {
                runPoint(points[i], (int64_t)i, false);
            }
        }
        std::fprintf(stderr, "[host] warmup done launches=%lld\n", (long long)launchIdx);
        for (int32_t r = 0; r < reps; ++r) {
            for (size_t i = 0; i < points.size(); ++i) {
                runPoint(points[i], (int64_t)i, true);
            }
        }
        std::fprintf(f, "# first_recorded_launch %lld reps %d points %d warmup %d\n", (long long)launchIdx -
                     int64_t(reps) * int64_t(points.size()), reps, (int)points.size(), warmup);
        std::fclose(f);
        std::fprintf(stderr, "[host] done recorded=%lld\n", (long long)recIdx);
    } else {
        for (int32_t r = 0; r < reps; ++r) {
            runPoint(points[0], 0, false);
        }
    }

    aclrtFree(srcDev);
    aclrtFree(stampDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
