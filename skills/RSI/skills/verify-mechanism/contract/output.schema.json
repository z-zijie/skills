{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rsi/skills/verify-mechanism/output.schema.json",
  "title": "verify-mechanism output",
  "description": "The verdict object. Same shape as schemas/verdict.schema.json, restated here because a skill's contract is frozen independently of the shared schema; when they disagree, this file is what the skill is held to.",
  "type": "object",
  "additionalProperties": false,
  "required": ["hypothesis_id", "verdict", "checks"],
  "properties": {
    "hypothesis_id": {"type": "string", "pattern": "^H-[0-9]+$"},
    "op": {"type": "string"},
    "verdict": {"type": "string", "enum": ["confirmed", "refuted", "not_implemented"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "conclusion"],
        "properties": {
          "id": {"type": "string", "pattern": "^[ABCD][0-9]+$"},
          "group": {"type": "string", "enum": ["A", "B", "C", "D"]},
          "conclusion": {"type": "string", "enum": ["pass", "fail", "unknown"]},
          "evidence": {"type": "string", "description": "Where in the diff or the binary summary it is visible."},
          "note": {"type": "string"}
        }
      }
    },
    "missing": {
      "type": "array",
      "items": {"type": "string"},
      "description": "For not_implemented: the evidence that is absent. The implementer retries from this."
    },
    "counter_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric"],
        "properties": {
          "metric": {"type": "string"},
          "predicted_direction": {"type": "string", "enum": ["up", "down"]},
          "before": {"type": ["number", "null"]},
          "after": {"type": ["number", "null"]},
          "direction_ok": {"type": "boolean"},
          "exceeds_noise": {"type": "boolean"},
          "note": {"type": "string"}
        }
      }
    },
    "unreliable_metrics_cross_checked": {"type": "array", "items": {"type": "string"}},
    "created": {"type": "string"},
    "scaffold_commit": {"type": "string"}
  }
}
