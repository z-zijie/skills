// Single-file iteration bench: host driver + device kernel in one .asc file.
// Build (seconds, no wheel / no pip / no python):
//   bisheng -fPIC --npu-arch=dav-3510 -O3 --asc-aicore-lang \
//     bench.asc -o bench -lm -ldl -lplatform -ltiling_api -lmsprofiler
//
// Every ablation axis is a -D macro, so one source covers the whole matrix and
// the defaults reproduce the baseline bit for bit.
//
//   ./bench                          # WARMUP=5 ITERS=10 FLUSH=1
//   WARMUP=5 ITERS=10 ./bench
//
// Two numbers, both printed on one line each:
//   [timing] ...  [result] median=...   <- host-event timing, the fast signal
//   [accuracy] bad=... MERE=...         <- correctness gate
// kernel-perf profiles the same binary (see references/loop.md).

#include <algorithm>
#include <cmath>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <random>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"

// ------------------------------- knobs ---------------------------------------
// One -D per ablation axis. Add axes here; never fork the file per experiment.
#ifndef LANES          // elements per vector register
#define LANES 64
#endif
// The only tiling knob. The loop below is synchronous (copy, wait, compute, wait,
// store, wait), so there is no ping-pong depth to set: real double buffering is a
// kernel-side change, not a host flag. Keeping one knob means one experiment moves
// one number -- a knob that also resizes the tile silently turns two experiments
// into the same experiment measured twice.
#ifndef TILES           // tiles per core
#define TILES 4
#endif
#ifndef TILE_MAX        // UB capacity reserved per buffer, in elements
#define TILE_MAX 8192
#endif

#define CHECK_ACL(call)                                                        \
    do {                                                                       \
        aclError err_ = (call);                                                \
        if (err_ != ACL_SUCCESS) {                                             \
            fprintf(stderr, "ACL error %d at line %d\n", (int)err_, __LINE__);  \
            return 1;                                                          \
        }                                                                      \
    } while (0)

namespace {

// ---- device kernel: y = exp(x), fp16 -------------------------------
__global__ __aicore__ __vector__ void exp_kernel(GM_ADDR x, GM_ADDR y, int64_t total,
                                                 int64_t blockLength, int64_t tileSize)
{
    AscendC::GlobalTensor<half> xGm, yGm;
    int64_t bid = AscendC::GetBlockIdx();
    int64_t off = blockLength * bid;
    xGm.SetGlobalBuffer((__gm__ half *)x + off);
    yGm.SetGlobalBuffer((__gm__ half *)y + off);
    int64_t left = total - off;
    if (left > blockLength) left = blockLength;
    if (left <= 0) return;

    // Allocate the worst-case tile once; a LocalTensor built inside the loop is
    // scalar work on every iteration (see references/ablation-axes.md).
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    auto xl = alloc.Alloc<half, TILE_MAX>();
    auto yl = alloc.Alloc<half, TILE_MAX>();
    for (int64_t done = 0; done < left; done += tileSize) {
        uint32_t n = (uint32_t)((left - done) < tileSize ? (left - done) : tileSize);
        AscendC::DataCopy(xl, xGm[done], n);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::Exp(yl, xl, n);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
        AscendC::DataCopy(yGm[done], yl, n);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
}

// ---- L2 flush: walk a buffer far larger than L2 (128 MiB on Ascend950PR) -----
constexpr int64_t FLUSH_ELEMS = 96LL * 1024 * 1024;  // 201 MB of fp16

__global__ __aicore__ __vector__ void flush_kernel(GM_ADDR buf, int64_t n)
{
    AscendC::GlobalTensor<half> g;
    g.SetGlobalBuffer((__gm__ half *)buf);
    int64_t blocks = AscendC::GetBlockNum();
    int64_t per = (n + blocks - 1) / blocks;
    per = (per + 63) / 64 * 64;
    int64_t off = per * AscendC::GetBlockIdx();
    if (off >= n) return;
    int64_t left = n - off;
    if (left > per) left = per;
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    auto u = alloc.Alloc<half, 14848>();
    const int64_t chunk = 14848;
    for (int64_t done = 0; done < left; done += chunk) {
        uint32_t c = (uint32_t)((left - done) < chunk ? (left - done) : chunk);
        AscendC::DataCopy(u, g[off + done], c);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::DataCopy(g[off + done], u, c);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
}

double median_of(std::vector<double> v)
{
    std::sort(v.begin(), v.end());
    size_t n = v.size();
    return (n % 2) ? v[n / 2] : 0.5 * (v[n / 2 - 1] + v[n / 2]);
}

}  // namespace

int main(int argc, char **argv)
{
    const int64_t total = 1024LL * 1024;
    const size_t bytes = total * sizeof(uint16_t);
    int warmup = 5, iters = 10, flush = 1;
    if (const char *e = getenv("WARMUP")) warmup = atoi(e);
    if (const char *e = getenv("ITERS")) iters = atoi(e);
    if (const char *e = getenv("FLUSH")) flush = atoi(e);
    (void)argc; (void)argv;

    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    std::vector<uint16_t> hx(total), hy(total);
    std::mt19937 rng(11);
    std::uniform_real_distribution<float> dist(-1.0f, 1.0f);
    for (int64_t i = 0; i < total; ++i) {
        float v = dist(rng);
        __fp16 h = (__fp16)v;
        std::memcpy(&hx[i], &h, sizeof(uint16_t));
    }

    uint8_t *dx = nullptr, *dy = nullptr, *dflush = nullptr;
    CHECK_ACL(aclrtMalloc((void **)&dx, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&dy, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    if (flush) {
        CHECK_ACL(aclrtMalloc((void **)&dflush, FLUSH_ELEMS * sizeof(uint16_t),
                              ACL_MEM_MALLOC_HUGE_FIRST));
    }
    CHECK_ACL(aclrtMemcpy(dx, bytes, hx.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE));

    // Tiling: mirror the kernel under test, do not invent a second algorithm.
    auto platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    uint64_t ubSize = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ubSize);
    int64_t coreNum = platform->GetCoreNumAiv();
    if (coreNum <= 0) coreNum = 1;
    int64_t numBlocks = (total + 4096 - 1) / 4096;
    numBlocks = std::min(numBlocks, coreNum);
    numBlocks = std::max<int64_t>(numBlocks, 1);
    int64_t blockLength = (total + numBlocks - 1) / numBlocks;
    blockLength = (blockLength + LANES - 1) / LANES * LANES;
    int64_t tileSize = (blockLength + TILES - 1) / TILES;
    (void)ubSize;
    // Two clamps, both learned the hard way:
    //   align      -- a tile length that is not a multiple of the vector width
    //                 copies a ragged tail and the last tile comes back wrong.
    //   TILE_MAX   -- writing past the reserved UB capacity returns garbage while
    //                 the timing still looks faster.
    // The accuracy gate catches both; the clamps mean they never reach it.
    tileSize = (tileSize + LANES - 1) / LANES * LANES;
    if (tileSize > TILE_MAX) tileSize = TILE_MAX;

    // Print every field the timing depends on. An ablation is only an ablation if
    // exactly one of these changed between the two runs being compared.
    printf("[cfg] blocks=%lld blockLength=%lld tileSize=%lld tiles=%lld lanes=%lld flush=%d "
           "warmup=%d iters=%d\n",
           (long long)numBlocks, (long long)blockLength, (long long)tileSize, (long long)TILES,
           (long long)LANES, flush, warmup, iters);

    auto launch = [&]() {
        exp_kernel<<<numBlocks, nullptr, stream>>>((GM_ADDR)dx, (GM_ADDR)dy, total, blockLength,
                                                   tileSize);
    };

    // Warm-up is not part of the statistic: the first launch pays TLB / I-cache
    // fill and measures 5-13% above steady state on this part, independent of how
    // good the kernel is.
    for (int i = 0; i < warmup; ++i) launch();
    CHECK_ACL(aclrtSynchronizeStream(stream));

    std::vector<double> us;
    for (int i = 0; i < iters; ++i) {
        // Flush L2 before every timed launch so each sample starts cold, the way
        // the scoring harness measures. Without it the number is 15-25% low.
        if (flush && dflush) {
            flush_kernel<<<numBlocks, nullptr, stream>>>((GM_ADDR)dflush, FLUSH_ELEMS);
            CHECK_ACL(aclrtSynchronizeStream(stream));
        }
        aclrtEvent s = nullptr, e = nullptr;
        aclrtCreateEvent(&s);
        aclrtCreateEvent(&e);
        aclrtRecordEvent(s, stream);
        launch();
        aclrtRecordEvent(e, stream);
        CHECK_ACL(aclrtSynchronizeStream(stream));
        float ms = 0.0f;
        aclrtEventElapsedTime(&ms, s, e);
        us.push_back((double)ms * 1000.0);
        aclrtDestroyEvent(s);
        aclrtDestroyEvent(e);
    }

    printf("[timing] ");
    for (double v : us) printf("%.2f ", v);
    printf("\n[result] median=%.2f us  min=%.2f  max=%.2f\n", median_of(us),
           *std::min_element(us.begin(), us.end()), *std::max_element(us.begin(), us.end()));

    // Accuracy gate: an optimisation that changes the output is a different kernel,
    // and the number it produced is not comparable to the baseline.
    CHECK_ACL(aclrtMemcpy(hy.data(), bytes, dy, bytes, ACL_MEMCPY_DEVICE_TO_HOST));
    double worst = 0.0, sum_mere = 0.0;
    int64_t bad = 0;
    for (int64_t i = 0; i < total; ++i) {
        __fp16 hx16;
        std::memcpy(&hx16, &hx[i], sizeof(uint16_t));
        double want = std::exp((double)(float)hx16);
        __fp16 hy16;
        std::memcpy(&hy16, &hy[i], sizeof(uint16_t));
        double got = (double)(float)hy16;
        double rel = std::fabs(got - want) / std::max(std::fabs(want), 1e-6);
        sum_mere += rel;
        if (rel > worst) worst = rel;
        if (rel > 9.77e-4) ++bad;
    }
    printf("[accuracy] bad=%lld / %lld  worst_rel=%.3e  MERE=%.3e\n", (long long)bad,
           (long long)total, worst, sum_mere / (double)total);
    printf("%s\n", bad ? "RESULT: FAIL" : "RESULT: PASS");

    aclrtFree(dx);
    aclrtFree(dy);
    if (dflush) aclrtFree(dflush);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return bad ? 1 : 0;
}
