// Floor probe: how much time does an empty kernel of this shape cost?
// Build: bisheng -fPIC --npu-arch=dav-3510 -O3 --asc-aicore-lang floor.asc -o floor \
//          -lm -ldl -lplatform -ltiling_api -lmsprofiler
//
// This exists so a measured improvement can be compared against the fixed cost the
// machine charges for launching anything at all. Two floors, because they are not
// the same number:
//   FLOOR_MODE 0 -- return from Process() immediately: pure dispatch + entry/exit
//   FLOOR_MODE 1 -- keep Init and one 64-element tile: framework cost + one DMA round trip
// A measurement that cannot beat the floor it is bounded by has no room to improve.
#include <cstdio>
#include <cstdlib>
#include <vector>
#include <algorithm>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"

#ifndef FLOOR_MODE
#define FLOOR_MODE 0
#endif
#ifndef BLOCKS
#define BLOCKS 56
#endif

#define CHECK_ACL(call)                                                        \
    do {                                                                       \
        aclError err_ = (call);                                                \
        if (err_ != ACL_SUCCESS) {                                             \
            fprintf(stderr, "ACL error %d at line %d\n", (int)err_, __LINE__);  \
            return 1;                                                          \
        }                                                                      \
    } while (0)

namespace {

__global__ __aicore__ __vector__ void floor_kernel(GM_ADDR x, GM_ADDR y, int64_t total)
{
    if (FLOOR_MODE == 0) {
        return;  // nothing at all: the floor the hardware charges unconditionally
    }
    AscendC::GlobalTensor<half> xGm, yGm;
    xGm.SetGlobalBuffer((__gm__ half *)x);
    yGm.SetGlobalBuffer((__gm__ half *)y);
    AscendC::LocalMemAllocator<AscendC::Hardware::UB> alloc;
    auto xl = alloc.Alloc<half, 64>();
    auto yl = alloc.Alloc<half, 64>();
    AscendC::DataCopy(xl, xGm[0], 64);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::Exp(yl, xl, 64);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
    AscendC::DataCopy(yGm[0], yl, 64);
    (void)total;
}

}  // namespace

int main()
{
    CHECK_ACL(aclInit(nullptr));
    CHECK_ACL(aclrtSetDevice(0));
    aclrtStream stream = nullptr;
    CHECK_ACL(aclrtCreateStream(&stream));

    const size_t bytes = 1024 * sizeof(uint16_t);
    uint8_t *dx = nullptr, *dy = nullptr;
    CHECK_ACL(aclrtMalloc((void **)&dx, bytes, ACL_MEM_MALLOC_HUGE_FIRST));
    CHECK_ACL(aclrtMalloc((void **)&dy, bytes, ACL_MEM_MALLOC_HUGE_FIRST));

    printf("[cfg] mode=%d blocks=%d\n", (int)FLOOR_MODE, (int)BLOCKS);

    auto launch = [&]() { floor_kernel<<<BLOCKS, nullptr, stream>>>((GM_ADDR)dx, (GM_ADDR)dy, 64); };

    for (int i = 0; i < 5; ++i) launch();   // warm-up: first launch pays TLB / I-cache
    CHECK_ACL(aclrtSynchronizeStream(stream));

    std::vector<double> us;
    for (int i = 0; i < 20; ++i) {
        aclrtEvent s = nullptr, e = nullptr;
        aclrtCreateEvent(&s);
        aclrtCreateEvent(&e);
        aclrtRecordEvent(s, stream);
        launch();
        aclrtRecordEvent(e, stream);
        CHECK_ACL(aclrtSynchronizeStream(stream));
        float ms = 0.0f;
        aclrtEventElapsedTime(&ms, s, e);
        us.push_back((double)ms * 1000.0);
        aclrtDestroyEvent(s);
        aclrtDestroyEvent(e);
    }
    std::vector<double> sorted = us;
    std::sort(sorted.begin(), sorted.end());
    double med = (sorted.size() % 2) ? sorted[sorted.size() / 2]
                                     : 0.5 * (sorted[sorted.size() / 2 - 1] + sorted[sorted.size() / 2]);
    printf("[timing] ");
    for (double v : us) printf("%.2f ", v);
    printf("\n[result] median=%.2f us  min=%.2f  max=%.2f\n", med, sorted.front(), sorted.back());

    aclrtFree(dx);
    aclrtFree(dy);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
