#!/bin/bash
# cnb-npu-lock <command...> — run one command holding the single NPU lock.
#
# This box has one card and wedges when two kernels are exercised at once, so
# every NPU-touching command has to queue on state/npu.lock.
#
# Re-entrancy is decided by the lock descriptor, not by an environment flag: if
# this process already has $LOCK open, it is inside a holder's subtree and must
# run the command directly instead of queueing behind its own ancestor. The test
# walks this shell's own fds, so it stays correct however the caller was
# wrapped, and it cannot be lost the way an env var can.
set -uo pipefail
ROOT=/workspace/cannbench
LOCK=$ROOT/state/npu.lock

held_here() {
  local fd
  for fd in /proc/$$/fd/*; do
    [ "$(readlink "$fd" 2>/dev/null)" = "$LOCK" ] && return 0
  done
  return 1
}

if [ -n "${CNB_NPU_LOCK_HELD:-}" ] || held_here; then
  exec "$@"
fi

# fd 7 is dedicated to this lock. Never reuse fd 9: lib.sh's npu_lock() uses 9,
# and two layers sharing one descriptor can close each other's open file
# description, which silently drops the lock.
exec 7>"$LOCK"
if ! flock -w "${CNB_NPU_LOCK_WAIT:-7200}" 7; then
  echo "[cnb-npu-lock] timed out waiting for $LOCK" >&2
  exit 75
fi
# Export too: a child that cannot see inherited fds (e.g. after a re-exec that
# closes them) still learns it was already granted.
export CNB_NPU_LOCK_HELD=1
"$@"
RC=$?
flock -u 7 2>/dev/null || true
exec 7>&-
exit $RC
